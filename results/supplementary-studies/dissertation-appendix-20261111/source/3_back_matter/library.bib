% Used in: Ch3
@misc{picmg_com_hpc,
  title        = {{COM}{-HPC}® Overview},
  author       = {{PCI Industrial Computer Manufacturers Group (PICMG)}},
  year         = {2023},
  howpublished = {\url{https://www.picmg.org/openstandards/com-hpc/}},
  note         = {COM-HPC ist ein offener Standard für leistungsfähige Computer-on-Modules.  Der 2021 ratifizierte Standard zielt auf Bandbreiten und Leistungsbudgets der Serverklasse ab.  COM-HPC-Module sind in größeren Abmessungen erhältlich (bis zu 200\,mm \(\times\) 160 mm) und unterstützen Leistungsbudgets bis zu 300 W und Speicherkapazitäten bis zu 1 TB.  Zu den neuen Funktionen gehören PCI Express Gen 5, USB4, DisplayPort 2.0 und 25-GbE-Schnittstellen, die leistungsfähige heterogene Prozessoren und Beschleuniger ermöglichen}
}

% Used in: Ch3
@misc{sget_qseven,
  title        = {{Qseven} Computer-On-Module Standard},
  author       = {{Standardization Group for Embedded Technologies (SGET)}},
  year         = {2021},
  howpublished = {\url{https://sget.org/standards/qseven/}},
  note         = {Das Qseven-Konzept definiert einen Standard für serienmäßig verfügbare Computer-on-Modules, der alle zentralen PC-Funktionen auf einem Modul mit 70\,mm \(\times\) 70 mm oder 40\,mm \(\times\) 70 mm integriert.  Ein einzelner robuster MXM-Steckverbinder mit standardisierter Pinbelegung verbindet das Modul mit einer Trägerplatine und führt alle I/O-Signale.  Qseven-Module umfassen Grafik, Audio, Massenspeicher, Netzwerk und mehrere USB-Anschlüsse und unterstützen sowohl x86- als auch ARM-Prozessoren, wodurch sie sich für mobile und IoT-Anwendungen eignen}
}

% Used in: Ch3
@misc{sget_smarc,
  title        = {Smart Mobility {ARChitecture} (SMARC) Standard},
  author       = {{Standardization Group for Embedded Technologies (SGET)}},
  year         = {2026},
  howpublished = {\url{https://sget.org/standards/smarc/}},
  note         = {Definiert die SMARC-Modulspezifikation: Das SMARC-Modul ist ein vielseitiges Computer-on-Module mit kleinem Formfaktor für Anwendungen, die geringe Leistungsaufnahme, niedrige Kosten und hohe Rechenleistung erfordern.  Die Module verwenden typischerweise ARM-SoCs oder alternativ stromsparende x86-Bausteine mit typischen Leistungsbudgets unter 6 W.  Zwei Modulgrößen sind definiert (82\,mm \(\times\) 50 mm und 82\,mm \(\times\) 80 mm), die jeweils einen Platinenrand-Steckverbinder mit 314 Kontakten verwenden.  SMARC-Module integrieren CPU, DRAM, Boot-Flash und GBE und nutzen anwendungsspezifische Trägerplatinen für Audio-, Touchscreen- oder Drahtlosfunktionen}
}

